DATABASE_URL=sqlite:///./chess_review.db
JWT_SECRET=generate-a-private-64-character-secret
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
ENGINE_THREADS=1
ENGINE_HASH_MB=128
ENGINE_DEPTH=16
ENGINE_MULTIPV=3
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SESSION_COOKIE_NAME=stockfish_review_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
CSRF_COOKIE_NAME=stockfish_review_csrf
VITE_CSRF_COOKIE_NAME=stockfish_review_csrf
FRONTEND_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
CHESSCOM_USER_AGENT=StockfishReview/1.0
CHESSCOM_TIMEOUT_SECONDS=20
